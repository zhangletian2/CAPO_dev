# ============================================================
# capo per-clone configuration.
# Copy to `.env` (git-ignored) and point each variable to your
# local data / weight locations.  See ASSETS.md for sizes and
# sub-folder layouts.
# ============================================================

# --- Datasets (one root per task) -----------------------------
# CLS_DATA_SRC should contain: imagenet/, imagenet-{adversarial,rendition,sketch,v2}/,
# fgvc_aircraft/, oxford_{flowers,pets}/, dtd/, stanford_cars/, ucf101/,
# caltech-101/, food-101/, sun397/, eurosat/.
# After running `scripts/preprocess_enc2dec.sh cls`, each of these will also
# get a sibling `new/` folder with QP=1 reconstructed images (see ASSETS.md section 3.1).
CLS_DATA_SRC=/absolute/path/to/cls_datasets

# RET_DATA_SRC should contain: coco2014/, flickr30k/, nocaps/.
# After `scripts/preprocess_enc2dec.sh ret`, a `coco2014_cloud/val2014/`
# subfolder (QP=1 reconstructions of the 5000 karpathy_test images) is
# created automatically (see ASSETS.md section 3.2).
RET_DATA_SRC=/absolute/path/to/ret_datasets

# SEG_DATA_SRC should contain: ade/ADEChallengeData2016/ and VOCdevkit/VOC2012/.
SEG_DATA_SRC=/absolute/path/to/seg_datasets


# --- Pretrained weights ---------------------------------------
# OpenAI CLIP cache (RN50.pt, RN101.pt, ViT-B-16.pt, ViT-L-14.pt).
# `clip.load(download_root=...)` will fetch missing weights here.
CLIP_CACHE_SRC=/absolute/path/to/openai_clip_cache

# MaskCLIP backbones and text embeddings
# (ViT16_clip_backbone.pth, RN50_clip_backbone.pth, ade_*_clip_text.pth,
#  voc_*_clip_text.pth, *_clip_weights.pth).
SEG_PRETRAIN_SRC=/absolute/path/to/maskclip_pretrain

# (Optional) LAVIS retrieval checkpoints. If set, must contain a `clip/`
# sub-folder with RN50.pt / ViT-B-16.pt / ViT-L-14.pt.
# If UNSET (recommended), setup.sh will automatically symlink
# capo_ret/pretrained/clip -> capo_cls/clip_cache, reusing the same CLIP
# weights. Only set this if you need a truly separate copy.
# RET_PRETRAINED_SRC=/absolute/path/to/ret_pretrained

# enc2dec codec model(s). At minimum `model0_qp1.pk` (85 MB) is required;
# `model0_qp7.pk` is NOT needed (QP=7 is skipped in this repo).
ENC2DEC_MODELS_SRC=/absolute/path/to/enc2dec_models


# --- Optional: output dirs ------------------------------------
# If set, setup.sh will redirect artifact dirs (logs/results/
# checkpoints/saved_params_*) to these locations instead of keeping
# them inside each capo_<task>/ as real dirs. Leave blank to keep
# artifacts in-tree (sensible default for a fresh clone).
CLS_OUTPUT_SRC=
RET_OUTPUT_SRC=
SEG_OUTPUT_SRC=
ENC2DEC_OUTPUT_SRC=


# --- Optional: GPU visibility ---------------------------------
# Defaults to "2,3,4,5,6,7" in scripts/_paths.sh.
# CUDA_VISIBLE_DEVICES=0,1,2,3


# --- Optional: external sibling repos -------------------------
# MLMP provides preprocessed Cityscapes images consumed by
# enc2dec/scripts/run_enc_dec_cityscapes.sh (not part of CEO).
# MLMP_ROOT=/absolute/path/to/MLMP
